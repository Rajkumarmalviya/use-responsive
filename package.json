{
  "name": "use-responsive",
  "version": "1.0.0",
  "description": "Lightweight, SSR-safe, type-safe React hook for responsive breakpoints with custom screen names",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "dev:lib": "tsup --watch",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"example/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"example/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run type-check && npm run test && npm run build"
  },
  "keywords": [
    "react",
    "hook",
    "responsive",
    "breakpoints",
    "media-query",
    "ssr",
    "typescript",
    "useResponsive",
    "react-hooks",
    "tailwind",
    "mobile-first"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/use-responsive.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/use-responsive/issues"
  },
  "homepage": "https://github.com/yourusername/use-responsive#readme"
}
